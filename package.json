{
  "name": "alist-watchparty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AList / OpenList / 小雅 alist direct-link watch party: remux playback, external subtitles, synced rooms and danmaku discussion.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-vendor.mjs",
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node --test test/*.test.mjs && node test/dom-smoke.mjs && node test/dom-room.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node test/browser.mjs",
    "test:dom": "node test/dom-smoke.mjs",
    "test:dom-room": "node test/dom-room.mjs"
  },
  "dependencies": {
    "jassub": "^2.5.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1"
  }
}
